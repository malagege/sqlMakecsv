# 資料庫驅動：mysql / postgres / sqlserver（或 mssql）/ sqlite / odbc（僅 Windows 預設內建）
DRIVER=mysql

# 連線字串（依驅動不同，格式請見 README.md）
DATASOURCE=root:@tcp(localhost:3306)/attendance?timeout=15s&allowOldPasswords=1

# 是否輸出欄位名稱列：true / false
WRITEHEADER=true

# 畫面顯示模式：SHOW_ALL / SHOW_INFO / SHOW_ERROR / HIDE_ALL
DISPLAY_MODE=SHOW_INFO

# 產生模式：
#   MAKE_ALL    - 每次都重新產生
#   MAKE_MODIFY - SQL 檔比輸出檔新才重新產生
#   MAKE_NOFILE - 輸出檔不存在才產生
MAKE_MODE=MAKE_MODIFY

# 重新產生前是否把舊輸出檔備份到 bak/：true / false
BACKUP_FILE=true

# 輸出格式：csv / xlsx
FILE_TYPE=csv
